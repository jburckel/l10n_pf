#. module: l10n_pf
#: model:ir.model.fields,help:l10n_pf.field_res_partner__tahiti
msgid ""
"TAHITI number of a Polynesian partner, read from its tax identifier. Empty "
"for partners of another country, whose tax identifier is a foreign VAT "
"number."
msgstr ""
"Numéro TAHITI d'un partenaire polynésien, lu dans son identifiant fiscal. "
"Vide pour les partenaires d'un autre pays, dont l'identifiant fiscal est un "
"numéro de TVA étranger."

#. module: l10n_pf
#: model:ir.model.fields,help:l10n_pf.field_res_company__tahiti
msgid "TAHITI number of the company, read from its tax identifier."
msgstr "Numéro TAHITI de la société, lu dans son identifiant fiscal."
