<?xml version="1.0" encoding="utf-8"?>
<odoo>
        <!-- The TAHITI number is the tax identifier in French Polynesia: it
             is entered once, in the standard tax identifier field. -->
        <record id="res_company_form_l10n_pf" model="ir.ui.view">
            <field name="name">res.company.form.l10n.pf</field>
            <field name="model">res.company</field>
            <field name="priority">20</field>
            <field name="inherit_id" ref="base.view_company_form"/>
            <field name="arch" type="xml">
            <data>
                 <xpath expr="//field[@name='vat']" position="attributes">
                    <attribute name="string">TAHITI / VAT No.</attribute>
                    <attribute name="placeholder">e.g. 123456</attribute>
                 </xpath>
                 <xpath expr="//field[@name='company_registry']" position="after">
                    <field name="cps"/>
                    <field name="ape"/>
                 </xpath>
            </data>
            </field>
        </record>

        <record id="res_partner_form_l10n_pf" model="ir.ui.view">
            <field name="name">res.partner.form.l10n.pf</field>
            <field name="model">res.partner</field>
            <field name="inherit_id" ref="base.view_partner_form"/>
            <field name="arch" type="xml">
            <data>
                 <xpath expr="//field[@name='vat']" position="attributes">
                    <attribute name="string">TAHITI / VAT No.</attribute>
                    <attribute name="placeholder">e.g. 123456</attribute>
                 </xpath>
            </data>
            </field>
        </record>
</odoo>
