<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- The TAHITI number is the tax identifier in French Polynesia: it is
         entered once, in the standard tax identifier field, labelled
         "TAHITI" through the vat_label of base.pf (data/res_country_data.xml). -->
    <record id="res_company_form_l10n_pf" model="ir.ui.view">
        <field name="name">res.company.form.l10n.pf</field>
        <field name="model">res.company</field>
        <field name="priority">20</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='company_registry']" position="after">
                <field name="cps"/>
                <field name="ape"/>
            </xpath>
        </field>
    </record>
</odoo>
